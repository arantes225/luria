# LURIA Marketing Studio — Variáveis de Ambiente Opcionais

# Google Chrome / Chromium (detectado automaticamente se instalado no padrão do Windows)
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Integração Oficial Metricool (opcional — necessário apenas para agendamento direto de rascunhos)
# Obtenha em: https://app.metricool.com > Account Settings > API
METRICOOL_API_TOKEN="seu_token_api_aqui"
METRICOOL_USER_ID="seu_user_id_numerico"

# Configuração de Fuso Horário
TZ="America/Sao_Paulo"
