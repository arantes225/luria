{
  "name": "luria-ecg-capture-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototipo de captura local de ECG impresso no iOS e Android - sem interpretacao clinica",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
