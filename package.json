{
  "name": "luria-client-checks",
  "private": true,
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:prompts": "node scripts/sync-admin-prompts.cjs",
    "check": "npm run check:syntax && npm run check:css && npm run check:prompts && npm test",
    "check:css": "node scripts/check-css.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "jsdom": "29.0.1",
    "postcss": "8.5.30"
  }
}
